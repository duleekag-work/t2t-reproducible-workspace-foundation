# Committed template. Contains no secrets - only placeholder values.
# Copy to .env (which is git-ignored) and edit locally:
#
#   cp .env.example .env
#
# The Dev Container does this automatically on first creation.

# --- Server -----------------------------------------------------------------
PORT=4000

# `mongo` is the Docker Compose service name, resolved on the container network.
# Outside the Dev Container this would be localhost instead.
MONGO_URL=mongodb://mongo:27017
MONGO_DB=t2t_demo

# Used from Session 3 onward. Present here so the shape is familiar.
LOG_LEVEL=info

# --- Client -----------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never put a secret behind this prefix - it ships to the browser.
VITE_API_BASE_URL=http://localhost:4000
